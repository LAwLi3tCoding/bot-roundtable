# Example only. Install your own certificates and replace the domain.
# Place this server block in an existing nginx http context.
server {
    listen 443 ssl;
    server_name bots.example.com;
    ssl_certificate /etc/letsencrypt/live/bots.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bots.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    client_max_body_size 32k;
    client_body_timeout 10s;
    location = /mcp {
        proxy_pass http://127.0.0.1:8766;
        proxy_http_version 1.1;
        proxy_set_header Host bots.example.com;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 60s;
        proxy_send_timeout 15s;
    }
    location / { return 404; }
}
