<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>org.roundtable.server</string>
<key>ProgramArguments</key><array><string>/bin/sh</string><string>${ROUNDTABLE_HOME}/scripts/start-local.sh</string><string>server</string></array>
<!-- start-local.sh inherits the process environment; launchd does not inherit shell exports.
     If outbound proxying is required, add ROUNDTABLE_OUTBOUND_PROXY to this dictionary
     with the reviewed HTTP origin http://127.0.0.1:PORT (replace PORT locally).
     Leave it absent for direct mode. See docs/DOT_SETUP.en.md for all required variables. -->
<key>EnvironmentVariables</key><dict><key>ROUNDTABLE_HOME</key><string>${ROUNDTABLE_HOME}</string></dict>
<key>RunAtLoad</key><false/>
<key>KeepAlive</key><false/>
</dict></plist>
